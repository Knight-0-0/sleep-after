<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="从真正睡着的那一刻开始计时，睡够 N 小时才叫你。闹钟走系统通道，Doze 也照响。"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="目标睡眠时长（从判定入睡起算）"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minus15"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="－15" />

            <TextView
                android:id="@+id/target"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="8 小时 00 分"
                android:textColor="@color/accent"
                android:textSize="24sp" />

            <Button
                android:id="@+id/plus15"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="＋15" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@color/card"
            android:lineSpacingExtra="5dp"
            android:padding="16dp"
            android:text="未启动"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/latency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="还没有记录，先跑一晚"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/arm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="开始守夜"
            android:textSize="17sp" />

        <Button
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="取消"
            android:visibility="gone" />

        <Button
            android:id="@+id/strictBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="静止 8 分钟算睡着" />

        <Button
            android:id="@+id/exactPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="打开精确闹钟权限（必做）" />

        <Button
            android:id="@+id/battPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="把本应用加入电池白名单（强烈建议）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="使用方式：睡前插上充电、点「开始守夜」、放下手机睡觉。\n\n判定规则：只有「屏幕熄灭 + 持续静止」才计时，躺床上刷手机不会被误判。\n\n整夜不响应时，先检查电池白名单和自启动权限。"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
