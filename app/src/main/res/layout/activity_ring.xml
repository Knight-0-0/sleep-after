<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_night">

    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:layout_marginTop="-120dp"
        android:background="@drawable/moon_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="07:42"
            android:textColor="@color/text"
            android:textSize="76sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="你睡够了"
            android:textColor="@color/accent"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="这是从判定入睡开始算的"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/bg_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:stateListAnimator="@null"
            android:text="长按 3 秒 关闭闹钟"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp" />

        <Button
            android:id="@+id/snooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ghost"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="再睡 9 分钟"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
