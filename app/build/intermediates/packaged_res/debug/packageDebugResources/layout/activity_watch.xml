<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_night">

    <View
        android:id="@+id/moonGlow"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/moon_glow" />

    <LinearLayout
        android:id="@+id/watchContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="54dp"
        android:paddingEnd="28dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.34"
            android:text="SLEEP  AFTER"
            android:textColor="@color/accent"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/moon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="34dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_moon" />

        <TextView
            android:id="@+id/phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:letterSpacing="0.08"
            android:text="等待入睡"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="00:00"
            android:textColor="@color/text"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="已等待"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="4dp"
            android:layout_marginTop="26dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_sleep" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="熄屏并静止 8 分钟后开始计时"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/stopWatch"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_ghost"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="取消守夜"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="把手机放床上，插着充电"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
